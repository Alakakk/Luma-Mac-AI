{
  "name": "luma-mac-ai",
  "version": "1.4.0-mac-ai.1",
  "description": "Local-first macOS calendar, todos and configurable AI assistant.",
  "homepage": "https://github.com/Alakakk/Luma-Mac-AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alakakk/Luma-Mac-AI.git"
  },
  "main": "main.cjs",
  "author": "Luma Todo contributors and Alakakk",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check src/appearance.js && node --check src/app.js && node --check src/week-view.js && node --check src/lifelog.js && node --check src/lifelog-boot.js && node --check main/ai.cjs && node --check src/ai-actions.js && node --check src/ai.js && npm run test:unit && node scripts/check-invariants.cjs",
    "dist": "npm run dist:mac",
    "start:demo": "electron . --demo",
    "start:real": "electron .",
    "start:demo:reset": "electron . --demo --demo-reset",
    "start:icloud": "electron . --icloud-test",
    "test:unit": "node --test qa/icloud-ics.test.cjs qa/appearance.test.cjs qa/week-drag.test.cjs qa/ai.test.cjs",
    "demo:covers": "node scripts/download-lifelog-covers.cjs",
    "start:demo:reset-lifelog": "electron . --demo --demo-reset-lifelog",
    "dist:mac": "electron-builder --config electron-builder.mac.cjs --mac --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.lumatodo.desktop",
    "productName": "Luma Todo",
    "asar": true,
    "electronUpdaterCompatibility": ">=2.16",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "main/**/*",
      "preload.cjs",
      "index.html",
      "src/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json",
      "!demo/**",
      "!scripts/**",
      "!qa/**",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "assets/desktop-window.ps1",
        "to": "desktop-window.ps1"
      },
      {
        "from": "credentials.json",
        "to": "credentials.json"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "Luma-Todo-Setup-${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Luma Todo"
    },
    "publish": null
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
